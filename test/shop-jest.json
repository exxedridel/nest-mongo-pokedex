{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testMatch": [
    "<rootDir>/test/shop.e2e-spec.ts",
    "<rootDir>/test/shop.repository-spec.ts",
    "<rootDir>/test/center.e2e-spec.ts"
  ],
  "transform": { "^.+\\.(t|j)s$": "ts-jest" },
  "testTimeout": 15000,
  "maxWorkers": 1
}
